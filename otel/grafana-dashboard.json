        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 400,
      "title": "💾 Disk I/O",
      "type": "row"
    },
    {
      "id": 31,
      "title": "Disk I/O Throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "rate(system_disk_io{server_name=~\"$server_name\", server_environment=~\"$server_environment\", direction=\"read\"}[$__rate_interval])",
          "legendFormat": "Read — {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(system_disk_io{server_name=~\"$server_name\", server_environment=~\"$server_environment\", direction=\"write\"}[$__rate_interval]) * -1",
          "legendFormat": "Write — {{device}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
