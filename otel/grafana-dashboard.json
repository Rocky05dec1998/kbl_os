    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 500,
      "title": "📁 Filesystem",
      "type": "row"
    },
    {
      "id": 41,
      "title": "Filesystem Usage",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "system_filesystem_usage{server_name=~\"$server_name\", server_environment=~\"$server_environment\", state=\"used\"}",
          "legendFormat": "{{mountpoint}} ({{device}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 50000000000
              },
              {
                "color": "#F2495C",
                "value": 80000000000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 42,
      "title": "Filesystem Utilization %",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (server_name, device, mountpoint) (system_filesystem_usage{server_name=~\"$server_name\", server_environment=~\"$server_environment\", state=\"used\"}) / sum by (server_name, device, mountpoint) (system_filesystem_usage{server_name=~\"$server_name\", server_environment=~\"$server_environment\"}) * 100",
          "legendFormat": "{{mountpoint}} ({{device}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 60
              },
              {
                "color": "#F2495C",
