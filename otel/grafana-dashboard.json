          "legendFormat": "Read — {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(system_disk_operations{server_name=~\"$server_name\", server_environment=~\"$server_environment\", direction=\"write\"}[$__rate_interval]) * -1",
          "legendFormat": "Write — {{device}}",
